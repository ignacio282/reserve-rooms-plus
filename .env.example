# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key; used only for Realtime broadcast in the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Only for `npm run db:setup`: Project Settings -> Database -> Session pooler URI
SUPABASE_DB_URL=

# Any long random string; signs the rotating check-in codes
CHECKIN_CODE_SECRET=
